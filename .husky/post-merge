#!/bin/sh

# Auto-release: minor bump + tag + push after merging into main.

[ "$ZENBORG_RELEASING" = "1" ] && exit 0

branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" != "main" ] && exit 0

last_msg=$(git log -1 --pretty=%s)
case "$last_msg" in release:*|chore:\ bump\ version*) exit 0 ;; esac

export ZENBORG_RELEASING=1
bash scripts/bump-version.sh minor
git push origin main --tags
